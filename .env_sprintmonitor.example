# Spritmonitor API Credentials
# You can generate the Bearer Token and find your Application-ID in your Spritmonitor settings.
SPRITMONITOR_APP_ID=your_application_id_here
SPRITMONITOR_BEARER=your_bearer_token_here

# Spritmonitor Vehicle ID
# This is the numeric ID of your vehicle in Spritmonitor (can be found in the URL when viewing your vehicle)
SPRITMONITOR_VEHICLE_ID=123456

# Honda Configuration
# This is your vehicle's VIN or the nickname you assigned to it in the Honda app.
HONDA_VIN=YOUR_HONDA_VIN_OR_NICKNAME

# (Optional) Honda Login Credentials
# If you haven't generated a token file yet, the adapter will use these to login and generate one.
HONDA_EMAIL=your_honda_email@example.com
HONDA_PASSWORD=your_honda_password

# (Optional) Custom Token Paths
# By default, tokens are saved to ~/.honda_tokens.json and ~/.honda_device_key.pem
# HONDA_TOKEN_FILE=/path/to/.honda_tokens.json
# HONDA_KEY_FILE=/path/to/.honda_device_key.pem
